{
  "name": "pdf-editor-backend",
  "version": "1.0.0",
  "description": "PDF Merger — Node.js/Express API for merging PDF files",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "RATE_LIMIT_MAX=10000 RATE_LIMIT_HEAVY_MAX=1000 MAX_CONCURRENT_HEAVY=50 node --test server.test.js",
    "test:security": "node --test security.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@pdf-editor/contract": "file:../shared/contract",
    "connect-timeout": "^1.9.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.2.5",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
