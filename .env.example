# Per-file PDF size limit (keep backend and frontend values in sync)
MAX_FILE_SIZE_MB=100
VITE_MAX_FILE_SIZE_MB=100

# Frontend API base URL (optional). Empty = relative /api (Vite dev proxy or same-origin in production).
# Example for a separate API host: VITE_API_BASE=https://api.example.com
VITE_API_BASE=

# Backend CORS (comma-separated origins). Default: http://localhost:5173
# Empty string disables CORS (Docker / same-origin behind nginx).
CORS_ORIGIN=http://localhost:5173
